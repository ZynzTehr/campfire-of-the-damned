# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The server refuses to start if a cost setting is missing or out of range (SPEC §8.3).

# --- Secrets (server only, never sent to the browser) ---
GEMINI_API_KEY=
DATABASE_URL=                 # Neon connection string (only needed when STORE=neon)

# --- AI ---
AI_ENABLED=true               # kill switch: false = cache-only, no AI calls
GEMINI_MODEL=                 # confirm current Flash-Lite id in AI Studio

# --- Cost cap (paid prices, used for shadow cost on the free tier) ---
PRICE_INPUT_PER_M_USD=0.30
PRICE_OUTPUT_PER_M_USD=2.50
MAX_PROMPT_TOKENS=600
MAX_OUTPUT_TOKENS=300
MAX_CONCURRENT_AI_CALLS=3
APP_RPM_CAP=                  # ~80% of provider RPM from AI Studio
APP_RPD_CAP=                  # ~80% of provider RPD from AI Studio
PER_IP_PER_MINUTE=5
PER_IP_PER_HOUR=30
DAILY_AI_CALL_CAP=500
DAILY_USD_CAP=1.00
MONTHLY_USD_CAP=10.00
DEGRADED_AI_CALLS_PER_HOUR=20

# --- Runtime ---
STORE=memory                  # memory (tests/local) | neon (required on Vercel)
IP_SOURCE=socket              # socket (local) | vercel (reads x-real-ip, which Vercel overwrites)
ALLOWED_ORIGIN=http://localhost:5173
SEED_STORIES=true             # preload a few stories so the offline demo has a fallback
PORT=8787
